{
  "name": "server-manager",
  "version": "1.1.2",
  "description": "Linux 服务器管理 Web 工具",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"nodemon server/index.js\" \"vite\"",
    "dev:server": "nodemon server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "icon": "node scripts/make-icon.mjs",
    "verify:session": "node scripts/verify-sessions.mjs",
    "app:build": "npm run build",
    "app:dev": "concurrently -k -n server,web,desktop -c blue,green,magenta \"nodemon server/index.js\" \"vite\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "app": "npm run build && electron-builder --dir",
    "rebuild": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server scripts",
    "test": "node scripts/verify-sessions.mjs && node scripts/verify-20-sessions.mjs && node scripts/stress-transfer-stability.mjs && node scripts/stress-switch-stability.mjs && node scripts/stress-process-reliability.mjs && node scripts/verify-fullhistory.mjs"
  },
  "build": {
    "appId": "com.serverhub.app",
    "npmRebuild": false,
    "productName": "ServerHub",
    "copyright": "Copyright © 2026 ServerHub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ServerHub",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/headless": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7"
  }
}
